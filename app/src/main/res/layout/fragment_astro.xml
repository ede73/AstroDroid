<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.AstroFragment">

    <android.opengl.GLSurfaceView
        android:id="@+id/gl_star_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.ede.astrodroid.ui.SkyLabelOverlayView
        android:id="@+id/sky_label_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/debug_texts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#99000000"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textViewAngularView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            tools:text="Field of view 90° · pinch to zoom · swipe up to hide stats" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/check_stars"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#FFFFFFFF"
                android:checked="true"
                android:text="Stars"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/check_planets"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#FFFFFFFF"
                android:checked="true"
                android:text="Planets"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/check_galaxies"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#FFFFFFFF"
                android:checked="true"
                android:text="Galaxies"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/check_names"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#FFFFFFFF"
                android:checked="true"
                android:text="Names"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_magnitude_limit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Magnitude: all"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/seek_magnitude"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:contentDescription="Visible magnitude limit"
            android:max="120"
            android:progress="120" />

        <LinearLayout
            android:id="@+id/debug_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPhoneHeading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                tools:text="Heading: 235°" />

            <TextView
                android:id="@+id/tvPhonePitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                tools:text="Pitch: -1°" />

            <TextView
                android:id="@+id/tvPhoneRoll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                tools:text="Roll: 0°" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
